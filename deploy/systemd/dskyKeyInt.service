# dskyKeyInt — keypad interrupt daemon (PCF8575 keypads, LED, SysV command queue)
#
# Runs as root: libpigpio hard-checks geteuid()==0 at gpioInitialise().
# LD_LIBRARY_PATH points at /home/pi/run where the bundled libpigpio*.so live
# (no system libpigpio is installed on the Pi).
#
# Install with deploy/systemd/install-services.sh.

[Unit]
Description=dsky keypad interrupt daemon (i2c PCF8575 + GPIO)
After=multi-user.target
# SysV IPC queue keys derive from ftok() of these marker files (IDs 10 and 12).
# They persist on disk; the touch is boot robustness for a fresh filesystem.
ExecStartPre=/usr/bin/touch /var/local/dskykeyint /var/local/dskycmd
# Give up after repeated crash-looping instead of restarting forever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/home/pi/run/dskyKeyInt
WorkingDirectory=/home/pi/run
Environment=LD_LIBRARY_PATH=/home/pi/run
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
