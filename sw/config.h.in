// Configuration document

// DSKY Versioning
#define DSKY_VERSION_MAJOR @dsky_VERSION_MAJOR@
#define DSKY_VERSION_MINOR @dsky_VERSION_MINOR@

#cmakedefine LOG_LEVEL @LOG_LEVEL@

// SDL FLAGS
#define SDL_WINDOW_FLAGS @SDL_WINDOW_FLAGS@

// FOnts
#define ZERLINA_FONT "@DSKY_RESOURCE_DIR@/fonts/Zerlina.ttf"

// Textures
#define DIGIT_TXT_FILE "@DSKY_RESOURCE_DIR@/images/DigitsSpriteTemplate.png"
#define DIGIT_GLOW_TXT_FILE "@DSKY_RESOURCE_DIR@/images/DigitsSpriteTemplate_glow.png"
#define SIGN_TXT_FILE "@DSKY_RESOURCE_DIR@/images/SignsSpriteTemplate.png"
#define SIGN_GLOW_TXT_FILE "@DSKY_RESOURCE_DIR@/images/SignsSpriteTemplate_glow.png"
#define GORTON_FONT_BITMAP "@DSKY_RESOURCE_DIR@/fonts/Gorton-Condensed_32px.png"
#define GORTON_FONT_FNT "@DSKY_RESOURCE_DIR@/fonts/Gorton-Condensed_32px.fnt"
#define LABEL_TXT_FILE "@DSKY_RESOURCE_DIR@/images/LabelsTemplateLGC.png"
#define GRID_HALF_TXT_FILE "@DSKY_RESOURCE_DIR@/images/Grid_half.png"
#define GRID_FULL_TXT_FILE "@DSKY_RESOURCE_DIR@/images/Grid_full.png"


// Default colors
#define GHOST_COLOR_R 0x15
#define GHOST_COLOR_G 0x0B
#define GHOST_COLOR_B 0x0C
#define GHOST_COLOR_A 0xFF

#define LIVE_COLOR_R 0x00
#define LIVE_COLOR_G 0xDD
#define LIVE_COLOR_B 0x88
#define LIVE_COLOR_A 0xFF

#define ALARM_YELLOW_COLOR_R 0xFF
#define ALARM_YELLOW_COLOR_G 0xFF
#define ALARM_YELLOW_COLOR_B 0x00
#define ALARM_YELLOW_COLOR_A 0xBB

// Default label green (dim green used for PROG/VERB/NOUN labels)
#define LABEL_GREEN_COLOR_R 0x88
#define LABEL_GREEN_COLOR_G 0x88
#define LABEL_GREEN_COLOR_B 0x88
#define LABEL_GREEN_COLOR_A 0x22

// Dots color (faint dot grid overlay)
#define DOTS_COLOR_R 0xF0
#define DOTS_COLOR_G 0xF0
#define DOTS_COLOR_B 0xF0
#define DOTS_COLOR_A 0x55

// Line color (faint separator lines)
#define LINE_COLOR_R 0xC0
#define LINE_COLOR_G 0xC0
#define LINE_COLOR_B 0xC0
#define LINE_COLOR_A 0x22

// Error red color (error text/highlights)
#define ERROR_RED_COLOR_R 0xFF
#define ERROR_RED_COLOR_G 0x32
#define ERROR_RED_COLOR_B 0x32

// Red element color (pure red, e.g. blinking X-cross during date correction)
#define RED_COLOR_R 0xFF
#define RED_COLOR_G 0x00
#define RED_COLOR_B 0x00
#define RED_COLOR_A 0xFF

// Disabled color (dimmed/inactive elements)
#define DISABLED_COLOR_R 0x28
#define DISABLED_COLOR_G 0x14
#define DISABLED_COLOR_B 0x14
#define DISABLED_COLOR_A 0x80

// Divider green (dim green separator line in the verb list)
#define DIVIDER_GREEN_COLOR_R 0x00
#define DIVIDER_GREEN_COLOR_G 0x80
#define DIVIDER_GREEN_COLOR_B 0x00
#define DIVIDER_GREEN_COLOR_A 0xFF

// Moon dim green (unlit part of the moon disk)
#define MOON_DIM_GREEN_COLOR_R 0x00
#define MOON_DIM_GREEN_COLOR_G 0x40
#define MOON_DIM_GREEN_COLOR_B 0x00
#define MOON_DIM_GREEN_COLOR_A 0xFF

// Debug yellow (debug frame border; opaque, unlike alarmYellow)
#define DEBUG_YELLOW_COLOR_R 0xFF
#define DEBUG_YELLOW_COLOR_G 0xFF
#define DEBUG_YELLOW_COLOR_B 0x00
#define DEBUG_YELLOW_COLOR_A 0xFF




// Default blinking Period [frames]
#define DEFAULT_BLINKING_PERIOD 20

// Message queue file 
#define KEY_INT_MSG_QUEUE_FILE "/var/local/dskykeyint"
#define KEY_INT_MSG_QUEUE_ID 10

// Message queue file for IN commands
#define CMD_MSG_QUEUE_FILE "/var/local/dskycmd"
#define CMD_MSG_QUEUE_ID 12

// Variable store persistence file
#define VAR_STORE_FILE "/var/local/dskyvars.json"

// Database connection configuration file (key=value format)
#define DB_CONF_FILE "/var/local/dskydb.conf"
